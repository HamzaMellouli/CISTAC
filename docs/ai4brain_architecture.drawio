<mxCell id="8" value="1. FRONTEND (User Interface)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F131E;strokeColor=#242C3F;strokeWidth=1.5;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="330" height="580" as="geometry"/></mxCell>
<mxCell id="9" value="&lt;b&gt;WEB DASHBOARD&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;3D Brain Mesh&lt;/b&gt; (glows by score)&lt;br&gt;• &lt;b&gt;AI Coach Orb&lt;/b&gt; (animated sphere)&lt;br&gt;• &lt;b&gt;Cognitive Radar Chart&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Live Reaction-Time Stats&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="290" height="160" as="geometry"/></mxCell>
<mxCell id="10" value="&lt;b&gt;TEST RUNNER (Focus Mode)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Clean Fullscreen Canvas&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Top 2px Progress Bar&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Zero-Distraction Layout&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Sub-millisecond Click Timer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="11" value="&lt;b&gt;USER CV / WEBCAM TILE&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;160x120 Floating Window&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Posture / Calibration Box&lt;/b&gt;&lt;br&gt;• &lt;b&gt;100% Private (No video saved)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="290" height="130" as="geometry"/></mxCell>
<mxCell id="12" value="2. BACKEND (Core Engine)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F131E;strokeColor=#242C3F;strokeWidth=1.5;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="105" width="490" height="580" as="geometry"/></mxCell>
<mxCell id="13" value="&lt;b&gt;FASTAPI SERVER &amp; API GATEWAY&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Starts sessions • Ingests live clicks &amp; reaction times • Delivers coach feedback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="450" height="110" as="geometry"/></mxCell>
<mxCell id="14" value="&lt;b&gt;PSYCHOMETRIC SCORING &amp; BRAIN FILTER&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Decision Speed (DDM):&lt;/b&gt; Measures drift rate &amp; reaction time&lt;br&gt;• &lt;b&gt;Ability Score (3PL-IRT):&lt;/b&gt; Computes exact cognitive difficulty curve&lt;br&gt;• &lt;b&gt;5-Region Brain Kalman Filter:&lt;/b&gt; Tracks dlPFC, ACC, vlPFC, etc.&lt;br&gt;• &lt;b&gt;Finds Weakest Area:&lt;/b&gt; Pinpoints exact bottleneck to train next" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="410" y="285" width="450" height="175" as="geometry"/></mxCell>
<mxCell id="15" value="&lt;b&gt;PROCEDURAL TEST GENERATOR&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Memory Test (N-Back):&lt;/b&gt; Letter sequence with proactive trick lures&lt;br&gt;• &lt;b&gt;Logic Test (RFT):&lt;/b&gt; Puzzles like &#x27;Is A &gt; C if A &gt; B and B &gt; C?&#x27;&lt;br&gt;• &lt;b&gt;85% Optimal Rule:&lt;/b&gt; Automatically makes puzzles easier/harder&lt;br&gt;• &lt;b&gt;Zero Memorization:&lt;/b&gt; Never repeats the exact same puzzle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="410" y="485" width="450" height="170" as="geometry"/></mxCell>
<mxCell id="16" value="3. NOT DONE YET (Planned in Blueprint)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F131E;strokeColor=#242C3F;strokeWidth=1.5;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="910" y="105" width="480" height="580" as="geometry"/></mxCell>
<mxCell id="17" value="&lt;b&gt;AI BRAIN TWIN (SAT-JEPA)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#F77F00&#x27;&gt;&lt;b&gt;[ ⏳ NOT DONE — EMPTY FOLDER ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;PyTorch neural network to forecast user cognitive growth trajectory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#F77F00;strokeWidth=2;dashed=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="930" y="150" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="18" value="&lt;b&gt;BEHAVIOR CLUSTERING (GMM)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#F77F00&#x27;&gt;&lt;b&gt;[ ⏳ NOT DONE — EMPTY FOLDER ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Groups users into 9 cognitive archetypes with anti-flicker threshold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#F77F00;strokeWidth=2;dashed=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="930" y="280" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="19" value="&lt;b&gt;TASK BLUEPRINT BACKGROUND CACHE&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#F77F00&#x27;&gt;&lt;b&gt;[ ⏳ NOT DONE — EMPTY FOLDER ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Background AI queue to pre-generate puzzle pools in &amp;lt;10ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#F77F00;strokeWidth=2;dashed=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="930" y="410" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="20" value="&lt;b&gt;FULL CHATBOT COACH &amp; VOICE REST&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#F77F00&#x27;&gt;&lt;b&gt;[ ⏳ NOT DONE — EMPTY FOLDER ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Multi-turn voice coaching dialogue &amp; automatic 10-second rest breaks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#F77F00;strokeWidth=2;dashed=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="930" y="540" width="440" height="115" as="geometry"/></mxCell>
<mxCell id="21" value="4. DATA STORAGE &amp; HOW IT RUNS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F131E;strokeColor=#242C3F;strokeWidth=1.5;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="715" width="1360" height="140" as="geometry"/></mxCell>
<mxCell id="22" value="&lt;b&gt;In-Memory Store&lt;/b&gt; &amp;nbsp; &lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Saves active user sessions &amp; scores instantly in RAM with zero setup." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="50" y="755" width="410" height="80" as="geometry"/></mxCell>
<mxCell id="23" value="&lt;b&gt;Postgres (pgvector) &amp; Redis&lt;/b&gt; &amp;nbsp; &lt;font color=&#x27;#F77F00&#x27;&gt;&lt;b&gt;[ ⏳ DOCKER READY, NOT CONNECTED ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Containers are set up in docker-compose, but Python backend uses in-memory store for now." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#F77F00;strokeWidth=2;dashed=1;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="755" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="24" value="&lt;b&gt;HOW TO RUN IT RIGHT NOW&lt;/b&gt; &amp;nbsp; &lt;font color=&#x27;#00F2FE&#x27;&gt;&lt;b&gt;[ ✓ WORKING ]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Run in PowerShell: &lt;code&gt;.\ai4brain-main\scripts\run_dev.ps1&lt;/code&gt;&lt;br&gt;Opens Dashboard on &lt;b&gt;port 3000&lt;/b&gt; and Backend on &lt;b&gt;port 8000&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141824;strokeColor=#00F2FE;strokeWidth=2;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="940" y="755" width="430" height="80" as="geometry"/></mxCell>
